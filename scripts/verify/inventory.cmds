# needs: inventory
# What a player carries: the starting loadout on screen, a health kit used with its key, a round
# taken from the reserve, and the loadout again after a death and a new match. Run from the
# repository root.
spawn.solo 0
spawn.join 1
physics.teleport player_1 6 0.6 20
wait_until 600 assert.visual_ready player_0
wait 80
assert.inventory 0 rifle_ammo 60
assert.inventory 0 health_kit 1
assert.hud_text hud_ammo_rifle Rifle 30/30 +60
assert.hud_text hud_item0 Health kit x1
snapshot inventory_start
# At full health the key does nothing.
input.tap E
wait 3
assert.inventory 0 health_kit 1
inventory.grant 0 health_kit 9
wait 3
assert.inventory 0 health_kit 3
health.damage 0 70 1
wait 3
assert.health 0 30
snapshot inventory_wounded
input.tap E
wait 3
assert.health 0 80
assert.inventory 0 health_kit 2
assert.hud_text hud_item0 Health kit x2
snapshot inventory_healed
# One round fired and reloaded comes out of the reserve.
input.capture_cursor
wait 2
movement.look 0 -0.1
wait 3
input.tap MouseLeft
wait 3
input.tap R
wait 110
assert.hud_text hud_ammo_rifle Rifle 30/30 +59
health.kill 0
wait 3
assert.inventory 0 rifle_ammo 0
assert.inventory 0 health_kit 0
assert.hud_shown hud_item0 false
snapshot inventory_dead
wait_until 300 assert.health 0 100
wait 3
assert.inventory 0 rifle_ammo 60
assert.inventory 0 health_kit 1
inventory.grant 0 health_kit 2
wait 3
match.restart
wait 3
assert.inventory 0 health_kit 1
snapshot inventory_restarted
quit
