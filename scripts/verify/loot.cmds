# needs: inventory loot
# Pickups on the map, in pictures: seen, taken, back again, what the dead drop.
# Kept short, a browser renders every frame; the other rules are in simulation/loot.cmds. Run from
# the repository root.
spawn.solo 0
spawn.join 1
physics.teleport player_1 6 0.6 14
physics.teleport player_0 20 0.6 11
wait_until 600 assert.visual_ready player_0
wait 80
assert.loot_available health_east true
snapshot loot_health_visible
# Walking over the health pickup.
input.key_down W
wait_until 200 assert.loot_available health_east false
input.key_up W
wait 5
assert.inventory 0 health_kit 2
assert.hud_text hud_item0 Health kit x2
assert.hud_text hud_pickup0 +1 Health kit
snapshot loot_health_notice
physics.teleport player_0 20 0.6 11
wait 40
snapshot loot_health_taken
wait 800
assert.hud_shown hud_pickup0 false
assert.loot_available health_east false
wait_until 200 assert.loot_available health_east true
wait 5
snapshot loot_health_respawned
# Player 1 dies and leaves what it carried.
physics.teleport player_0 6 0.6 18
wait 60
health.kill 1
wait 5
assert.loot_drops 1
wait 200
snapshot loot_death_drop
# A kit used makes room for the one lying there.
health.damage 0 40 1
wait 3
input.tap E
wait 3
assert.inventory 0 health_kit 1
input.key_down W
wait_until 200 assert.loot_drops 0
input.key_up W
wait 5
assert.inventory 0 rifle_ammo 120
assert.inventory 0 health_kit 2
snapshot loot_drop_taken
quit
