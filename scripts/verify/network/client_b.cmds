# Network check, client B (player 1): renders (natively or in the browser), watches client A walk,
# then shoots it and sees it respawn. It does not walk.
wait_until 3000 assert.net_joined
wait_until 3000 assert.spawn_count 2
wait_until 3000 assert.visual_ready player_0
wait_until 3000 assert.visual_ready player_1
wait_until 3000 assert.movement_near 1 3 0 18 0.1
assert.visuals_color 0 0
assert.visuals_color 1 1
wait 20
# Its own over-the-shoulder view.
assert.shoulder_distance arena_camera 3.0 3.7
snapshot net_b_own_view
shoulder.stop arena_camera
camera.set_position arena_camera 6 7 29
camera.look_at arena_camera 0 0 17
snapshot net_b_start
# Tells client A to start.
movement.look 1 0
wait_until 20000 assert.animation_playing player_0/visual Walk
snapshot net_b_a_walking
# Where client A's walk ends.
wait_until 20000 assert.movement_near 0 -0.15 0 17.37 0.5
wait_until 2000 assert.visuals_state 0 idle
wait 64
# The other player is drawn smoothly, and the picture settles where it is.
assert.drawn_position player_0 -0.15 0.6 17.37 0.6
snapshot net_b_sees_a
# Aims at client A's player with its own camera again (the server puts that player on the spot).
shoulder.follow arena_camera
camera.set_fov arena_camera 70
movement.look 1.561 -0.273
wait_until 20000 assert.movement_near 0 -0.15 0 17.37 0.05
wait 64
assert.hud_shown hud_crosshair true
assert.ui_text hud_health Health 100
assert.ui_text hud_ammo_rifle Rifle 30/30 +60
wait_until 20000 assert.hud_text hud_ammo_launcher Rockets 4/4 +8
snapshot net_b_aims
# A rocket takes most of player 0's health (and a little of this one's). It flies 3 m, too short
# to picture reliably here (rockets.cmds shows one in flight). Hit counts stay, so none is missed.
# The cursor is taken first, as a player's first click does (that click does not shoot).
input.capture_cursor
wait 2
input.tap MouseRight
wait_until 20000 assert.launcher_hits 1 1
# A slowly rendering machine would otherwise picture an earlier frame.
wait 64
snapshot net_b_rocket_hit
# The blast hurt this player too: a health kit, with its key.
input.tap E
wait_until 20000 assert.health 1 100
wait_until 20000 assert.inventory 1 health_kit 0
wait_until 20000 assert.hud_shown hud_item0 false
snapshot net_b_healed
# One rifle shot finishes it.
input.tap MouseLeft
wait_until 20000 assert.rifle_hits 1 1
# A slow machine can see the death (3 s) only after the respawn, so it checks the score, which
# stays; combat.cmds and rockets.cmds check that the dead are hidden.
wait_until 2000 assert.match_score 1 1
snapshot net_b_killed
# The respawn, seen from behind the player that came back.
wait_until 20000 assert.health 0 100
shoulder.follow arena_camera 0
wait_until 2000 assert.visuals_hidden 0 false
wait 128
snapshot net_b_sees_respawn
# The scoreboard of the running match, on the held button.
shoulder.follow arena_camera
input.key_down Tab
wait 10
wait_until 20000 assert.hud_text hud_match_score_row0 > Blue 1 1 0
wait_until 20000 assert.hud_text hud_match_score_row1 Red 0 0 1
snapshot net_b_scoreboard
input.key_up Tab
# Lets the server bring in client C.
movement.look 2.5 0
wait_until 60000 assert.spawn_count 3
movement.look 2 0
wait_until 60000 assert.match_finished
wait 64
wait_until 20000 assert.hud_text hud_match_banner Blue wins
wait_until 20000 assert.hud_shown hud_match_score_head true
snapshot net_b_result
movement.look -2 0
wait_until 60000 assert.match_running
wait 64
assert.match_score 1 0
assert.health 1 100
assert.rifle_ammo 1 30
assert.launcher_ammo 1 4
wait_until 20000 assert.hud_shown hud_match_banner false
wait_until 20000 assert.hud_shown hud_match_score_head false
snapshot net_b_restarted
# Client C leaves first.
wait_until 60000 assert.spawn_count 2
wait 64
net.bodies
net.states
net.stats
quit
