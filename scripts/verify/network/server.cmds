# Network check, server (see run.mjs): both clients get a character; once client B has left, the
# server's view of client A's character is printed for comparison.
wait_until 20000 assert.net_clients 2
wait_until 20000 assert.spawn_count 2
# The launcher is found on the map (../loot.cmds); here player 1 is simply given it.
inventory.grant 1 launcher 1
inventory.grant 1 rockets 8
# A slow machine must not run out of match while the steps below take their time.
match.set_clock 600
# Client B's character is put beside client A's path, so one picture shows both.
physics.teleport player_1 3 0.6 18
# Once client B aims, client A's player is put exactly where it aims.
wait_until 60000 assert.movement_look 1 1.561 0.01
physics.teleport player_0 -0.15 0.6 17.37
wait_until 60000 assert.health_dead 0
assert.launcher_hits 1 1
assert.rifle_hits 1 1
assert.match_score 1 1
wait_until 2000 assert.health 0 100
# B has seen the scoreboard of the two of them.
wait_until 60000 assert.movement_look 1 2.5 0.01
# run.mjs starts client C, which joins the running match, when it sees this line.
net.status
wait_until 60000 assert.spawn_count 3
# B and C have seen the running scoreboard.
wait_until 60000 assert.movement_look 1 2 0.01
wait_until 60000 assert.movement_look 2 3 0.01
match.set_clock 0.5
wait_until 2000 assert.match_finished
# The result stays until B and C have seen it.
match.set_clock 600
assert.match_winner 1
wait_until 60000 assert.movement_look 1 -2 0.01
wait_until 60000 assert.movement_look 2 -3 0.01
match.set_clock 0.5
wait_until 2000 assert.match_running
match.set_clock 600
assert.match_score 1 0
assert.health 0 100
assert.launcher_rockets 0
# B turns when it is ready to pick something up.
wait_until 60000 assert.movement_look 1 -1 0.01
physics.teleport player_1 20 0.6 6
wait_until 2000 assert.inventory 1 health_kit 2
assert.loot_available health_east false
# C leaves, then B.
wait_until 60000 assert.spawn_count 1
wait 64
net.bodies
net.states
net.stats
assert.net_refusals_at_most 0
# Stay until client A has printed and left.
wait_until 20000 assert.spawn_count 0
quit
