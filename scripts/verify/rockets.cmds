# Rockets and what shots look like, one machine: a shot over player 1's head misses, a rifle tracer,
# a rocket in flight, its explosion, the damage, a dead player that is walked through. Run from the
# repository root.
spawn.solo 0
spawn.join 1
physics.teleport player_1 0 0.6 19
wait_until 600 assert.visual_ready player_0
wait_until 600 assert.visual_ready player_1
wait 80
# Clearly above the fox.
movement.look 0.0859 -0.03
wait 20
input.tap MouseLeft
wait 3
assert.rifle_ammo 0 29
assert.health 1 100
snapshot rockets_shot_above
wait 30
movement.look 0.0859 -0.128
wait 20
input.tap MouseRight
wait 6
assert.launcher_rockets 1
assert.launcher_ammo 0 3
assert.health 1 100
snapshot rockets_flying
wait_until 100 assert.launcher_rockets 0
wait 4
assert.health 1 20
assert.launcher_hits 0 1
assert.ui_text hud_ammo_rifle Rifle 29/30
assert.ui_text hud_ammo_launcher Rockets 3/4
snapshot rockets_blast
wait 70
input.tap MouseRight
wait_until 100 assert.health_dead 1
wait 40
assert.visuals_hidden 1 true
# Straight on through where the dead player's body lies.
movement.look 0 -0.128
input.key_down W
wait 90
input.key_up W
wait 5
assert.movement_near 0 0 0 17 1.5
snapshot rockets_walked_through
quit
